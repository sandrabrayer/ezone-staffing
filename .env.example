# --- Required ---

# Apps Script Web App URL (the one ending in /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Shared secret. MUST match the SHARED_SECRET set in the Apps Script
# Script Properties. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHARED_SECRET=REPLACE_ME_WITH_LONG_RANDOM_HEX

# Moran's PIN (string, 4–12 chars; use digits only for keypad UX)
MORAN_PIN=REPLACE_ME

# Secret used to sign session tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_ME_WITH_LONG_RANDOM_HEX

# --- Optional ---

# Port (Railway sets this automatically)
PORT=3000

# Session lifetime in days (default 7)
SESSION_DAYS=7

# First-hadracha status feed (the hadrachot app's read-only endpoint) for the
# dashboard banner. OPTIONAL — leave both unset to disable the feature (the
# UI then shows nothing). The secret is only ever sent server-side by the
# /api/hadrachot-status proxy; the browser never sees it.
# HADRACHOT_STATUS_URL=https://script.google.com/macros/s/REPLACE_ME/exec
# HADRACHOT_STATUS_SECRET=REPLACE_ME_WITH_LONG_RANDOM_HEX

# /api/data read cache in the proxy (see docs/perf-load.md). Defaults shown;
# all in milliseconds. 0 for FRESH disables HIT (every read revalidates);
# 0 for REWARM disables the background refresh after a write.
# DATA_CACHE_FRESH_MS=60000
# DATA_CACHE_STALE_MS=86400000        # 24 h: an old copy is served at once while it refreshes
# DATA_CACHE_REWARM_MS=1500
# DATA_CACHE_KEEPWARM_MS=600000       # background re-read every 10 min; 0 = off

# Apps Script upstream (docs/perf-open.md). One queue for every call.
# UPSTREAM_CONCURRENCY=2              # max simultaneous Apps Script executions (1..6)
# UPSTREAM_READ_TIMEOUT_MS=45000
# UPSTREAM_WRITE_TIMEOUT_MS=120000
# UPSTREAM_RETRY_BASE_MS=400          # read retries wait 400 ms, then 1200 ms

# Read-cache snapshot on disk, restored at boot so a restart/redeploy is not
# a cold start. With a Railway volume mounted, the default is
# <RAILWAY_VOLUME_MOUNT_PATH>/staffing-cache (Railway sets that variable);
# the boot log prints the directory it chose.
# CACHE_SNAPSHOT=1                    # 0 = off
# CACHE_SNAPSHOT_DIR=/data/staffing-cache
# CACHE_SNAPSHOT_MAX_AGE_MS=86400000  # an older file is ignored
# CACHE_SNAPSHOT_INTERVAL_MS=300000
